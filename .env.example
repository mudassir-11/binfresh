# Supabase
VITE_SUPABASE_URL="your_supabase_project_url"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"  # optional, for webhooks

# Stripe (Frontend)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe (Backend / Vercel Functions only — never expose in frontend)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs (from Stripe Dashboard → Products)
STRIPE_PRICE_ONE_TIME="price_..."    # One-Time Clean $44.99
STRIPE_PRICE_FRESH="price_..."       # Fresh – Bi-Weekly $34.99/mo
STRIPE_PRICE_ESSENTIAL="price_..."   # Essential – Monthly $19.99/mo

# App
APP_URL="https://your-vercel-domain.vercel.app"
